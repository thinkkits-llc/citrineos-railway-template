# =============================================================================
# CitrineOS + Everest Full Stack — Railway Environment Variables
# =============================================================================
# Copy to .env and fill in required values before deploying.
# Variables marked [REQUIRED] must be set. Others have working defaults.
# =============================================================================

# --- PostgreSQL (Railway Plugin) ---
POSTGRES_DB=citrine
POSTGRES_USER=citrine
POSTGRES_PASSWORD=citrine                    # [REQUIRED] Change in production

# --- RabbitMQ (Railway Plugin) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest                  # [REQUIRED] Change in production

# --- Redis (Railway Plugin) ---
# No config needed — Railway Redis plugin auto-configures

# --- CitrineOS Core ---
APP_NAME=all
APP_ENV=docker
DB_STRATEGY=migrate
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
BOOTSTRAP_CITRINEOS_DATABASE_HOST=${{ocpp-db.RAILWAY_PRIVATE_DOMAIN}}
BOOTSTRAP_CITRINEOS_CONFIG_FILENAME=config.json
BOOTSTRAP_CITRINEOS_FILE_ACCESS_TYPE=local
BOOTSTRAP_CITRINEOS_FILE_ACCESS_LOCAL_DEFAULT_FILE_PATH=/data
CONFIG_CITRINEOS_WIPE_FILE_ON_START=true     # Set false in production

# --- Hasura GraphQL Engine ---
HASURA_GRAPHQL_DATABASE_URL=postgres://citrine:citrine@${{ocpp-db.RAILWAY_PRIVATE_DOMAIN}}:5432/citrine
HASURA_GRAPHQL_ENABLE_CONSOLE=true           # Set false in production
HASURA_GRAPHQL_DEV_MODE=true                 # Set false in production
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log
HASURA_GRAPHQL_ENABLE_TELEMETRY=false
# HASURA_GRAPHQL_ADMIN_SECRET=              # [REQUIRED] Set in production

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin               # [REQUIRED] Change in production

# --- CitrineOS OCPI ---
OCPI_APP_NAME=all
OCPI_APP_ENV=docker
OCPI_DB_HOST=${{ocpp-db.RAILWAY_PRIVATE_DOMAIN}}
OCPI_AMQP_URL=amqp://guest:guest@${{amqp-broker.RAILWAY_PRIVATE_DOMAIN}}:5672
OCPI_AMQP_EXCHANGE=citrineos

# --- CitrineOS Payment ---
STRIPE_API_KEY=sk_test_placeholder           # [REQUIRED] Real Stripe key
STRIPE_ENDPOINT_SECRET_ACCOUNT=whsec_placeholder
STRIPE_ENDPOINT_SECRET_CONNECT=whsec_placeholder
PAYMENT_DB_HOST=${{ocpp-db.RAILWAY_PRIVATE_DOMAIN}}
PAYMENT_DB_PORT=5432
PAYMENT_DB_DATABASE=citrine
PAYMENT_DB_USER=citrine
PAYMENT_DB_PASSWORD=citrine
PAYMENT_MESSAGE_BROKER_HOST=${{amqp-broker.RAILWAY_PRIVATE_DOMAIN}}

# --- Operator UI (Next.js) ---
NEXT_PUBLIC_API_URL=https://${{graphql-engine.RAILWAY_PUBLIC_DOMAIN}}/v1/graphql
NEXT_PUBLIC_WS_URL=wss://${{graphql-engine.RAILWAY_PUBLIC_DOMAIN}}/v1/graphql
NEXT_PUBLIC_CITRINE_CORE_URL=https://${{citrineos-core.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_FILE_SERVER_URL=https://${{directus.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_LOGO_URL=https://d1h8867rcwtfcw.cloudfront.net/logo-collapsed.svg
NEXT_PUBLIC_ADMIN_EMAIL=admin@citrineos.com
NEXTAUTH_URL=https://${{operator-ui.RAILWAY_PUBLIC_DOMAIN}}
NEXTAUTH_SECRET=change-me-to-random-secret   # [REQUIRED] Strong random value
ADMIN_PASSWORD=CitrineOS!

# --- Directus ---
DIRECTUS_KEY=change-me-to-a-random-key       # [REQUIRED] Random string
DIRECTUS_SECRET=change-me-to-a-random-secret # [REQUIRED] Random string
DIRECTUS_ADMIN_EMAIL=admin@citrineos.com
DIRECTUS_ADMIN_PASSWORD=CitrineOS!           # [REQUIRED] Change in production
DIRECTUS_DB_HOST=${{ocpp-db.RAILWAY_PRIVATE_DOMAIN}}
DIRECTUS_DB_PORT=5432
DIRECTUS_DB_DATABASE=citrine
DIRECTUS_DB_USER=citrine
DIRECTUS_DB_PASSWORD=citrine

# --- Everest Simulator ---
OCPP_VERSION=2.0.1                           # 1.6, 2.0.1, or 2.1
CITRINEOS_WS_URL=ws://citrineos-core.railway.internal:8081/cp001
EVEREST_IMAGE_TAG=2025.6.1-dt-esdp
